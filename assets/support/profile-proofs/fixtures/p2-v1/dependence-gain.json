  "validation_code": {
    "language": "Python 3, standard library",
    "source": "from fractions import Fraction as Q\nfrom itertools import product\nimport json\n\n\ndef evaluate(action, p, tau):\n    D = len(action)\n    states = [(1-p, [[1]*D, [0]*D]),\n              (p, [[-1]*D, [0]*D])]\n    risk = joint = overlap = Q(0)\n    marginal = [Q(0)]*D\n    for mass, theta in states:\n        indicators = []\n        loss = Q(0)\n        for d, a in enumerate(action):\n            grade = {'W': (1, 1), '+': (1, 2), '-': (2, 1)}[a]\n            N = int(grade[0] != grade[1])\n            F = sum(int(grade[i] < grade[j] and theta[i][d] <= theta[j][d])\n                    for i, j in [(0, 1), (1, 0)])\n            event = int(F > 0*N)\n            indicators.append(event)\n            marginal[d] += mass*event\n            loss += (Q(F) + tau*(1-N))/D\n        V = sum(indicators)\n        risk += mass*loss\n        joint += mass*int(V > 0)\n        overlap += mass*max(V-1, 0)\n    assert sum(marginal) - joint == overlap\n    return {'action': ''.join(action), 'risk': risk, 'J': joint,\n            'sum_p': sum(marginal), 'Delta': overlap}\n\n\ndef run():\n    specifications = [\n        (2, '1/10', '1/4', ['0','1/20','1/10','19/100','1/5','21/100','1']),\n        (3, '1/10', '1/4', ['0','1/20','1/10','19/100','1/5','29/100','3/10','31/100','1']),\n        (3, '2/5', '1/2', ['1/5','2/5','79/100','4/5','81/100','1']),\n        (3, '1/4', '1/4', ['1/8','1/4','1/2','3/4','1']),\n        (3, '2/5', '1/4', ['1/5','2/5','4/5','1']),\n        (2, '1/2', '1/2', ['0','1/4','1/2','3/4','1'])]\n    cases = []\n    checked_actions = 0\n    witness = []\n    for D, ps, ts, budgets in specifications:\n        p, tau = Q(ps), Q(ts)\n        for als in budgets:\n            alpha = Q(als)\n            rows = [evaluate(a, p, tau) for a in product('W+-', repeat=D)]\n            checked_actions += len(rows)\n            fj = [r for r in rows if r['J'] <= alpha]\n            fb = [r for r in rows if r['sum_p'] <= alpha]\n            assert fj and fb\n            assert {r['action'] for r in fb} <= {r['action'] for r in fj}\n            rj = min(r['risk'] for r in fj)\n            rb = min(r['risk'] for r in fb)\n            mj = sorted(r['action'] for r in fj if r['risk'] == rj)\n            mb = sorted(r['action'] for r in fb if r['risk'] == rb)\n            intersection = set(mj) & {r['action'] for r in fb}\n            assert (rj == rb) == bool(intersection)\n            for r in fj:\n                assert (r['sum_p'] <= alpha) == (r['Delta'] <= alpha-r['J'])\n            if p < tau:\n                k = min(D, alpha // p)\n                expected_b = Q(k, D)*p + (1-Q(k, D))*tau\n                expected_j = p if alpha >= p else tau\n                assert rb == expected_b and rj == expected_j\n                expected_mj = ['+'*D] if alpha >= p else ['W'*D]\n                expected_mb = sorted(''.join(a) for a in product('W+', repeat=D)\n                                     if a.count('+') == k)\n                assert mj == expected_mj and mb == expected_mb\n                expected_gap = (1-Q(k, D))*(tau-p) if alpha >= p else Q(0)\n                assert rb-rj == expected_gap\n            else:\n                assert 0 < tau <= p <= Q(1, 2)\n                assert rj == rb == tau\n                assert 'W'*D in mj and 'W'*D in mb\n            cases.append({'D': D, 'p': str(p), 'tau': str(tau), 'alpha': str(alpha),\n                          'joint_risk': str(rj), 'allocation_risk': str(rb),\n                          'gain': str(rb-rj), 'joint_minimizers': mj,\n                          'allocation_minimizers': mb,\n                          'joint_feasible_count': len(fj),\n                          'allocation_feasible_count': len(fb)})\n            if (D, p, tau, alpha) == (3, Q(1,10), Q(1,4), Q(1,10)):\n                witness = [{k: str(v) if isinstance(v, Q) else v for k,v in row.items()}\n                           for row in rows]\n    summary = {'status': 'PASS', 'parameter_cases': len(cases),\n               'action_parameter_evaluations': checked_actions,\n               'finite_state_evaluations': 2*checked_actions,\n               'exact_optimizer_pairs': len(cases),\n               'witness_D3_risks': {'joint':'1/10','allocation':'1/5','gain':'1/10'}}\n    return {'summary': summary, 'cases': cases, 'all_actions_D3_witness': witness}\n\nif __name__ == '__main__':\n    print(json.dumps(run()['summary'], indent=2))\n",
    "sha256": "2cfa4f53f7203f6306d9f1fb36b63ee765397f559d40d1aba8c945a5d09e2721",
