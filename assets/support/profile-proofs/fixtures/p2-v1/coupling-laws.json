  "validation_python": "from fractions import Fraction as Q\nfrom itertools import product\ncolumns=document['canonical_columns']\nactions=list(product(columns,repeat=2))\nassert len(actions)==9\nassert len({tuple(c) for c in columns.values()})==3\nassert set(map(tuple,columns.values()))=={(1,1),(1,2),(2,1)}\nweights=list(map(Q,document['decision']['weights']))\ntaus=list(map(Q,document['decision']['tau']))\nthresholds=list(map(Q,document['decision']['t']))\nalpha=Q(document['decision']['alpha'])\nassert sum(weights)==1 and document['decision']['P']==[]\nexpected={tuple(r['action']):r for r in document['expected_all_actions']}\nassert set(expected)==set(actions)\nmarginals=[]; results={}\nfor law in document['laws']:\n    assert sum(Q(s['mass']) for s in law['states'])==1\n    marginal=[]\n    for d in range(2):\n        m={}\n        for state in law['states']:\n            key=tuple(row[d] for row in state['theta'])\n            m[key]=m.get(key,Q(0))+Q(state['mass'])\n        assert m=={(1,0):Q(9,10),(-1,0):Q(1,10)}\n        marginal.append(m)\n    marginals.append(marginal)\n    rows=[]\n    for action in actions:\n        g=[[columns[action[d]][i] for d in range(2)] for i in range(2)]\n        N=[int(g[0][d]!=g[1][d]) for d in range(2)]\n        risk=Q(0); joint=Q(0)\n        for state in law['states']:\n            p=Q(state['mass']);theta=state['theta']\n            assert p>0 and all(theta[0][d]!=theta[1][d] for d in range(2))\n            F=[sum(int(g[i][d]<g[j][d] and theta[i][d]<=theta[j][d]) for i in range(2) for j in range(2) if i!=j) for d in range(2)]\n            assert all(0<=F[d]<=N[d]<=1 for d in range(2))\n            risk+=p*sum(weights[d]*(F[d]+taus[d]*(1-N[d])) for d in range(2))\n            joint+=p*int(any(F[d]>thresholds[d]*N[d] for d in range(2)))\n        label='coincident' if law['id']=='LAW-COINCIDENT' else 'disjoint'\n        exp=expected[action]\n        assert risk==Q(exp['risk']) and joint==Q(exp['J_'+label])\n        assert (joint<=alpha)==exp['feasible_'+label]\n        rows.append({'action':list(action),'grade_matrix':g,'risk':str(risk),'J':str(joint),'feasible':joint<=alpha,'grade_counts':[len(set(columns[a])) for a in action],'occupied_cells':len(set(map(tuple,g)))})\n    feasible=[r for r in rows if r['feasible']]\n    best=min(Q(r['risk']) for r in feasible)\n    winners=[r['action'] for r in feasible if Q(r['risk'])==best]\n    exp=document['expected_optima'][law['id']]\n    assert best==Q(exp['risk']) and winners==exp['actions']\n    winner_rows=[r for r in feasible if Q(r['risk'])==best]\n    assert [r['grade_counts'] for r in winner_rows]==exp['grade_counts']\n    assert [sum(k-1 for k in r['grade_counts']) for r in winner_rows]==exp['disclosed_pair_domain_statements']\n    assert [r['occupied_cells'] for r in winner_rows]==exp['occupied_cells']\n    results[law['id']]={'evaluated_actions':len(rows),'minimum_risk':str(best),'minimizers':winners,'rows':rows}\nassert marginals[0]==marginals[1]\nepsilon=Q(document['continuous_companion']['example_epsilon'])\nassert 0<epsilon<Q(1,2)\nassert 1-2*epsilon>0 and -1+2*epsilon<0\nassert 1-2*epsilon==Q(document['continuous_companion']['positive_gap_lower_bound'])\nassert -1+2*epsilon==Q(document['continuous_companion']['negative_gap_upper_bound'])\nprint('PASS: two coherent laws; identical full domain marginals; all18 action-law evaluations; exact minimizer sets; sign-preserving continuous-bound check')\n",
